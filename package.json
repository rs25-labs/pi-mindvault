{
  "name": "@rs25-labs/pi-mindvault",
  "version": "0.2.6",
  "description": "Private, local-first memory subsystem for the pi coding agent. Long-term memory across sessions, stored on your own machine in SQLite, with optional on-device semantic search. No server, no cloud, nothing leaves your machine.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/rs25-labs/pi-mindvault.git" },
  "homepage": "https://github.com/rs25-labs/pi-mindvault",
  "keywords": [
    "pi-package",
    "pi",
    "memory",
    "memory-subsystem",
    "agent-memory",
    "long-term-memory",
    "coding-agent",
    "ai-agent",
    "llm-memory",
    "local-first",
    "local",
    "private",
    "privacy",
    "on-device",
    "offline",
    "semantic-search",
    "embeddings",
    "vector-search",
    "rag",
    "sqlite"
  ],
  "type": "module",
  "files": ["extensions", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": { "node": ">=22.5.0" },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "image": "https://raw.githubusercontent.com/rs25-labs/pi-mindvault/main/preview.png"
  },
  "scripts": {
    "test": "MINDVAULT_CONFIG_PATH=tests/.absent-config.json tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "typebox": "^1.3.28"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "sqlite-vec": "^0.1.9"
  },
  "optionalDependencies": {
    "fastembed": "^2.1.0"
  }
}
